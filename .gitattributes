# Auto detect text files and normalize line endings to LF
* text=auto

# Force LF for source code
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.sh text eol=lf

# Force CRLF for Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.tar binary
*.gz binary
*.pdf binary
